extends Node
## Plays sound effects (and, from Stage 8, music) on the Music / SFX / UI buses.
##
## Sounds are looked up by name: a file at res://assets/audio/sfx/<name>.wav (or .ogg) wins,
## otherwise the placeholder recipe in SfxSynth is used. Music tracks come from
## res://assets/audio/music/<name>.ogg/.wav (generated by tools/generate_audio.gd), falling back to
## MusicSynth. Drop real files in to replace any of them.

const SFX_DIR: String = "res://assets/audio/sfx/"
const MUSIC_DIR: String = "res://assets/audio/music/"
const POOL_SIZE: int = 16

## Name of the most recently played sound (handy for tests and debugging).
var last_played: StringName = &""
var play_count: int = 0

var _players: Array[AudioStreamPlayer] = []
var _next_player: int = 0
var _cache: Dictionary = {}
var _music_player: AudioStreamPlayer
var _current_music: StringName = &""


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	for i: int in POOL_SIZE:
		var player: AudioStreamPlayer = AudioStreamPlayer.new()
		player.bus = &"SFX"
		add_child(player)
		_players.append(player)
	_music_player = AudioStreamPlayer.new()
	_music_player.bus = &"Music"
	add_child(_music_player)


## Stops every sound and the music.
func stop_all() -> void:
	for player: AudioStreamPlayer in _players:
		player.stop()
		player.stream = null
	_music_player.stop()
	_music_player.stream = null
	_current_music = &""


## Stops all audio and gives the audio server a moment to release it, then quits.
## (Quitting mid-sound otherwise leaves the playback alive at exit.)
func quit_game(exit_code: int = 0) -> void:
	stop_all()
	await get_tree().process_frame
	await get_tree().process_frame
	get_tree().quit(exit_code)


## Plays a one-shot sound effect. `pitch_jitter` randomizes pitch by up to +/- that fraction.
func play_sfx(sound_name: StringName, pitch_jitter: float = 0.05, volume_db: float = 0.0, bus: StringName = &"SFX") -> void:
	var stream: AudioStream = get_stream(sound_name)
	if stream == null:
		push_warning("AudioManager: no sound named '%s'" % sound_name)
		return
	var player: AudioStreamPlayer = _players[_next_player]
	_next_player = (_next_player + 1) % _players.size()
	player.stream = stream
	player.bus = bus
	player.volume_db = volume_db
	player.pitch_scale = 1.0 + randf_range(-pitch_jitter, pitch_jitter)
	player.play()
	last_played = sound_name
	play_count += 1


func play_ui(sound_name: StringName) -> void:
	play_sfx(sound_name, 0.0, 0.0, &"UI")


## Plays a looping music track by name (res://assets/audio/music/<name>.ogg/.wav). Keeps playing
## if it's already the current track; silent if the track doesn't exist.
func play_music(track: StringName) -> void:
	if track == _current_music and _music_player.playing:
		return
	_current_music = track
	var stream: AudioStream = _find_stream(MUSIC_DIR, track)
	if stream == null:
		stream = MusicSynth.build(track)
	if stream is AudioStreamWAV and (stream as AudioStreamWAV).loop_mode == AudioStreamWAV.LOOP_DISABLED:
		# Imported WAVs don't loop by default; loop the whole file.
		var wav: AudioStreamWAV = (stream as AudioStreamWAV).duplicate() as AudioStreamWAV
		wav.loop_mode = AudioStreamWAV.LOOP_FORWARD
		wav.loop_begin = 0
		wav.loop_end = int(wav.get_length() * wav.mix_rate)
		stream = wav
	if stream == null:
		_music_player.stop()
		return
	_music_player.stream = stream
	_music_player.play()


func stop_music() -> void:
	_current_music = &""
	_music_player.stop()


func get_current_music() -> StringName:
	return _current_music


func _find_stream(directory: String, stream_name: StringName) -> AudioStream:
	for extension: String in [".ogg", ".wav"]:
		var path: String = directory + String(stream_name) + extension
		if ResourceLoader.exists(path):
			return load(path)
	return null


func get_stream(sound_name: StringName) -> AudioStream:
	if _cache.has(sound_name):
		return _cache[sound_name]
	var stream: AudioStream = null
	for extension: String in [".wav", ".ogg"]:
		var path: String = SFX_DIR + String(sound_name) + extension
		if ResourceLoader.exists(path):
			stream = load(path)
			break
	if stream == null:
		stream = SfxSynth.build(sound_name)
	_cache[sound_name] = stream
	return stream
